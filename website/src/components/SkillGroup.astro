---
import { inlineHtml, type Skill } from "../lib/content";
import type { Group } from "../lib/groups";

interface Props { group: Group; num: number; byName: Record<string, Skill> }
const { group: g, num, byName } = Astro.props;
---
<div class="group">
  <div class="group-head">
    <span class="group-num">{String(num).padStart(2, "0")}</span>
    <h2>{g.title}</h2>
    <p>{g.intro}</p>
    <a class="start" href={`/skills/${g.start}/`}>Start with /{g.start}</a>
  </div>
  <div class="cards">
    {g.skills.map((name) => (
      <a class="card" href={`/skills/${name}/`}>
        <code>/{name}</code>
        <span set:html={inlineHtml(byName[name].summary)} />
      </a>
    ))}
  </div>
</div>
